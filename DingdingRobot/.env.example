# ============================================================
# 复制为 .env 后填写：cp .env.example .env
# ============================================================

# ===== 钉钉开放平台 =====
# 开放平台 -> 应用开发 -> 企业内部应用 -> 凭证与基础信息
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 机器人编码：机器人配置页；Stream 模式下主动发消息兜底时使用
DINGTALK_ROBOT_CODE=
# OpenAPI 地址；一般不用改
DINGTALK_API_BASE=https://api.dingtalk.com
# 访问钉钉外部 API 是否走系统代理。如果 Stream 连不上而浏览器正常，可尝试 false
DINGTALK_TRUST_ENV=true

# ===== LLM（本机 Ollama，OpenAI 兼容） =====
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT=120
LLM_MAX_TOOL_ROUNDS=6
LLM_TEMPERATURE=0.3
# 本机 Ollama 不要走系统代理（Windows 上 httpx 会读系统代理，导致 502）
# 如果换成需要代理的云端 API，改成 true
LLM_TRUST_ENV=false

# ===== 天气（和风天气 QWeather） =====
# 和风天气控制台 -> 项目 -> 设置，获取 API Key 和专属 API Host
WEATHER_API_KEY=
# 形如 https://xxxxxxxx.re.qweatherapi.com；旧版公共域名可用 https://devapi.qweather.com
WEATHER_API_BASE=https://your-api-host.qweatherapi.com
WEATHER_TIMEOUT=10
# 访问天气 API 是否走系统代理；如果代理导致请求失败，改成 false
WEATHER_TRUST_ENV=true

# ===== Redis =====
# 用 db 1，避免和 20261030 项目的 db 0 混在一起
REDIS_URL=redis://localhost:6379/1
# key 前缀；同一个 Redis 实例里区分不同应用
KEY_PREFIX=robot
QUEUE_MAXLEN=100000

# ===== 可靠性 / Worker =====
MAX_CONCURRENCY=4
MAX_ATTEMPTS=3
AGENT_TIMEOUT=280
CLAIM_MIN_IDLE_MS=360000
HISTORY_LIMIT=20
